{
  "name": "mcp-gateway",
  "version": "0.4.0",
  "description": "MCP Gateway with WebSocket proxy and shadcn UI",
  "type": "module",
  "bin": {
    "mcp-gateway": "./src/cli.js",
    "mcp-gateway-stdio": "./scripts/mcp-gateway-stdio.sh"
  },
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "stdio": "node src/gateway-stdio.js",
    "test": "node --test tests/runtime.test.js",
    "build:ui": "pnpm --filter mcp-gateway-ui run build",
    "dev:ui": "pnpm --filter mcp-gateway-ui run dev",
    "init:samples": "node src/init-samples.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@10.25.0",
  "workspaces": [
    "ui"
  ]
}
